# Doxyfile for libstl.
#
# Generate the API reference with:
#
#     doxygen Doxyfile          # HTML into build/docs/html
#
# The output directory is inside build/, which is git-ignored.
#
# WARN_AS_ERROR is on: the CI job runs doxygen and fails on any documentation
# warning, so a broken \ref or an unclosed group cannot be merged.

PROJECT_NAME           = "libstl"
PROJECT_BRIEF          = "The STL (Standard Template Library) for C"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                  = libstl.h README.md
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXCLUDE                = src tools tests
EXCLUDE_SYMBOLS        = stl__*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
ALPHABETICAL_INDEX     = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = STL_API= \
                         STL_CALL= \
                         STL_INLINE=static \
                         STL_UNUSED(x)= \
                         STL_PRIVATE= \
                         "stl_maybe_unused=" \
                         STL_HAVE_CLEANUP=0 \
                         STL_HAVE_CONVENIENCE_MACROS=1 \
                         STL_PLATFORM_WINDOWS=0 \
                         STL_PLATFORM_MSVC=0 \
                         STL_HAVE_PTHREAD=1 \
                         STL_HAVE_INT64=1 \
                         STL_HAVE_C99=1 \
                         STL_RESTRICT=
HAVE_DOT               = NO
QUIET                  = YES
