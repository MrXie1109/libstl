# Force LF line endings in the repository and in every working tree.
#
# Without this, Git's `core.autocrlf` default rewrites text files on Windows,
# so the header checked out there differs byte-for-byte from the one on Linux.
# That matters beyond tidiness: libstl.h is published as a release asset and
# shipped to users on every platform, and a stray CRLF would spread into their
# sources and break byte-exact comparisons.
#
# `eol=lf` normalises on checkout as well as on commit, so the Windows build
# produces a header identical to the other two platforms.
* text=auto eol=lf

# Windows build files are consumed by cmd.exe and nmake, which accept either
# ending, so they stay LF like everything else.
*.c        text eol=lf
*.h        text eol=lf
*.md       text eol=lf
Makefile   text eol=lf
Doxyfile   text eol=lf
*.yml      text eol=lf
*.py       text eol=lf

# Binary artefacts must never be touched.
*.a        binary
*.lib      binary
*.so       binary
*.dylib    binary
*.dll      binary
*.exe      binary
